<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never back up the encrypted token store or the Room cache -->
        <exclude domain="sharedpref" path="qvk_secure_prefs.xml" />
        <exclude domain="database" path="qvk.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="qvk_secure_prefs.xml" />
        <exclude domain="database" path="qvk.db" />
    </device-transfer>
</data-extraction-rules>
