{
  "name": "qmods-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "description": "QMods Telegram bot — Cloudflare Worker",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute qmods-telegram-bot --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute qmods-telegram-bot --file=./schema.sql --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.4.0"
  }
}
